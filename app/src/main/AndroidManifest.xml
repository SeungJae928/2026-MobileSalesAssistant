<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos 차량 이미지로 옮기면 required="true"로 바꾼다. 지금은 폰 AVD에서도 설치되도록 false -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- Pleos Vehicle SDK: Odometer, Gear -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 시트 메모리(운전자 프리셋) 조회·불러오기 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <!-- AAOS 차량 속성: 속도(런타임 권한), 주차브레이크·시동 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- Pleos 음성: 도착 시 질문(TTS), 답변 인식(STT) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- Pleos NaviHelper: 목적지·남은 거리·도착 이벤트(get*Info, 리스너) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- LLM(On-device)로 방문 원문을 구조화 -->
    <uses-permission android:name="pleos.car.permission.LLM_SERVICE" />
    <!-- 앱이 꺼져도 주행 기록 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".SalesDriveApp"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <!-- 주행 중에는 "기록 중" 화면만 보여 주므로 주행 중 표시를 허용받는다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".trip.TripService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="차량 주행을 자동 기록해 운행기록부를 만든다" />
        </service>
    </application>
</manifest>
